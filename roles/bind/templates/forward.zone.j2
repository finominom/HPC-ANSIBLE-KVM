{% set body %}
@          IN NS   master.{{ item.zone }}.
{% for name, addr in cluster_hosts | dictsort %}
{% if addr[item.key] is defined %}
{{ '%-10s' | format(name) }} IN A    {{ addr[item.key] }}
{% endif %}
{% endfor %}
{% endset -%}
; {{ ansible_managed }}
; Generated from cluster_hosts. The serial is a hash of the records, so it
; changes exactly when the records change (fine: there are no secondaries).
$TTL 3600
@   IN SOA master.{{ item.zone }}. hostmaster.{{ item.zone }}. (
        {{ (body | hash('md5'))[:7] | int(0, 16) }} ; serial
        3600       ; refresh
        900        ; retry
        1209600    ; expire
        300 )      ; negative cache
{{ body }}
