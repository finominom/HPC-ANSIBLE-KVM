# {{ ansible_managed }}
# Identical on every node. Edit roles/slurm, not this file.

ClusterName={{ slurm_cluster_name }}
SlurmctldHost={{ slurm_controller_host }}

SlurmUser=slurm
AuthType=auth/munge
SlurmctldPort=6817
SlurmdPort=6818
SrunPortRange={{ slurm_srun_port_range }}

StateSaveLocation={{ slurm_state_dir }}
SlurmdSpoolDir={{ slurm_spool_dir }}
SlurmctldPidFile={{ slurm_run_dir }}/slurmctld.pid
SlurmdPidFile={{ slurm_run_dir }}/slurmd.pid
SlurmctldLogFile={{ slurm_log_dir }}/slurmctld.log
SlurmdLogFile={{ slurm_log_dir }}/slurmd.log

ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup,task/affinity
MpiDefault=none
ReturnToService=1

SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core

{% if slurm_enable_accounting | bool %}
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost={{ slurm_controller_host }}
JobAcctGatherType=jobacct_gather/cgroup
JobAcctGatherFrequency=30
{% endif %}

# Compute nodes - short names; values from `slurmd -C` on each node
{% for host in groups[slurm_compute_group] %}
NodeName={{ hostvars[host].inventory_hostname_short }} {{ hostvars[host].slurm_node_params }} State=UNKNOWN
{% endfor %}

PartitionName={{ slurm_partition_name }} Nodes={{ groups[slurm_compute_group] | map('extract', hostvars, 'inventory_hostname_short') | join(',') }} Default=YES MaxTime={{ slurm_partition_maxtime }} State=UP
