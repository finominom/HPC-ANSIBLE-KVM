# {{ ansible_managed }}
AuthType=auth/munge
DbdHost={{ slurm_controller_host }}
DbdPort=6819
SlurmUser=slurm
LogFile={{ slurm_log_dir }}/slurmdbd.log
PidFile={{ slurm_run_dir }}/slurmdbd.pid

StorageType=accounting_storage/mysql
StorageHost=localhost
StoragePort=3306
StorageUser={{ slurm_db_user }}
StoragePass={{ slurm_db_pass }}
StorageLoc={{ slurm_db_name }}
