#!/bin/bash
# hpc-node-configure [--reconfigure] <node>
# Runs after Cobbler's install/post trigger (via hpc-configure@<node>.service), or by hand
# through 'hpc-node configure <node>' with --reconfigure (skips the reinstall checks).
#
#   INSTALLED -> NETBOOT_DISABLED -> (wait for first boot) -> CONFIGURING -> VALIDATING -> READY
#   any failure -> FAILED (with the reason in the message column and the log)
set -uo pipefail
source /usr/local/lib/hpc-provision/lib.sh

reconf=0
[ "${1:-}" = "--reconfigure" ] && { reconf=1; shift; }
node=${1:-}; valid_node "$node"
job=$(job_get "$node")
fqdn="$node.$NODE_DOMAIN"
log="$LOG_DIR/$node-$job.log"

exec 9>"$STATE_DIR/$node.lock"
flock -n 9 || die "another provisioning run for $node is active"

# log everything; also show it on the terminal when run by hand
if [ $reconf -eq 1 ]; then exec > >(tee -a "$log") 2>&1; else exec >>"$log" 2>&1; fi
echo "==== $(date -Is) hpc-node-configure $node job=$job reconfigure=$reconf"

fail() { state_set "$node" FAILED "$*"; echo "FAILED: $*"; exit 1; }

if [ $reconf -eq 0 ]; then
    # 1. netboot must be off before the node reboots (the kickstart already asked Cobbler)
    if [ "$(netboot_enabled "$node")" != "False" ]; then
        echo "netboot still on; disabling it from the master"
        cobbler system edit --name="$node" --netboot-enabled=0 && cobbler sync
    fi
    [ "$(netboot_enabled "$node")" = "False" ] || fail "could not disable netboot"
    state_set "$node" NETBOOT_DISABLED "confirmed in cobbler"

    # 2. wait until the node runs the system installed by THIS job
    forget_hostkeys "$node"
    deadline=$(( $(date +%s) + SSH_WAIT_TIMEOUT ))
    while :; do
        got=$(ssh -n -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new \
                  "root@$fqdn" cat /etc/hpc-provision-job 2>/dev/null)
        [ "$got" = "$job" ] && break
        [ "$(date +%s)" -lt "$deadline" ] || fail "node did not boot the new install within ${SSH_WAIT_TIMEOUT}s"
        sleep 20
    done
    echo "node booted the install of job $job from its disk"
    forget_hostkeys "$node"
    learn_hostkeys "$node"
else
    ssh -n -o BatchMode=yes -o ConnectTimeout=10 "root@$fqdn" true || fail "cannot ssh to $fqdn"
fi

# 3. configure with the existing project
state_set "$node" CONFIGURING "ansible $COMPUTE_PLAYBOOK"
cd "$ANSIBLE_DIR" || fail "no $ANSIBLE_DIR"
ansible-playbook -i "$INVENTORY" "$COMPUTE_PLAYBOOK" --limit "${node}*" \
    || fail "ansible $COMPUTE_PLAYBOOK failed (see $log)"

# 4. validate
state_set "$node" VALIDATING "ansible $VALIDATE_PLAYBOOK"
ansible-playbook -i "$INVENTORY" "$VALIDATE_PLAYBOOK" --limit "${node}*" \
    || fail "validation failed (see $log)"

state_set "$node" READY "all mandatory checks passed"
echo "==== $(date -Is) $node READY"
