---
# Copy to vault.yml in this folder, fill in, then:
#   ansible-vault encrypt inventory/vbox/group_vars/master/vault.yml

# Slurm accounting database password:  openssl rand -base64 24
vault_slurm_db_pass: "CHANGE-ME"

# Root password for nodes installed by xCAT (a hash, not the password):
#   openssl passwd -6
vault_node_root_password_hash: "$6$CHANGE-ME"

# Grafana web login "admin" (12+ characters):  openssl rand -base64 18
vault_grafana_admin_password: "CHANGE-ME"

# Optional: password for e-mailing alerts (for Gmail/Google Workspace an
# App Password). Leave as is if monitoring_alert_email_to is empty.
vault_alert_smtp_password: ""
